# Note: docker compose reads this file both to populate container env vars and
# to interpolate ${...} references in docker-compose.yml. Any literal "$" in a
# value (e.g. an auto-generated SECRET_KEY) must be escaped as "$$", or compose
# silently treats it as an unresolved variable reference and blanks it out.
DEBUG=True

# Security settings
SECRET_KEY="django-insecure-j8=!b-s3jv&!j$$5l=8y80d%lw$$tj)v4sc0!y74hl@*=(k9nc)k"
ALLOWED_HOSTS=<alb-dns>,<custom-domain>

# Security settings (not implemented yet)
CSRF_TRUSTED_ORIGINS=https://<domain>
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# AWS S3 configuration
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=<bucket-name>
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
ABOUT_PHOTO_URL=https://<bucket-name>.s3.amazonaws.com/about/me.png

# Development toggles
ENABLE_DEBUG_TOOLBAR=True
ENABLE_WHITENOISE=False

# Email configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<email-host>
EMAIL_HOST_USER=<email-user>
EMAIL_HOST_PASSWORD=<email-password>
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Database configuration
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>

# Django database URL format, <engine>://<database-user>:<database-password>@<host>:5432/<database-name>
# For example: postgres://user:password@host:5432/database_name
DATABASE_URL=<database-url>